    colLabels.put("year_no", "Năm");
    colLabels.put("setting_id", "Mã cấu hình");
    colLabels.put("setting_key", "Khóa cấu hình");
    colLabels.put("setting_value", "Giá trị cấu hình");
    colLabels.put("new_value", "Giá trị mới");
