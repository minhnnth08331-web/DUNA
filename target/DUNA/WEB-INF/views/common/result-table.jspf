    colLabels.put("mauc", "Mã UC");
    colLabels.put("trangthai", "Trạng thái");
    request.setAttribute("_dunaColLabels", colLabels);
%>
<div class="table-wrap" style="margin-top: 16px;">
    <c:choose>
        <c:when test="${empty resultRows}">
            <div style="padding: 28px; text-align: center; color: var(--muted);">
                Chưa có bản ghi phù hợp cho truy vấn <code>${activeUc}</code>.
            </div>
        </c:when>
        <c:otherwise>
            <table class="data-table">
                <thead>
                <tr>
                    <c:forEach items="${resultRows[0]}" var="col">
                        <c:set var="colKeyLower" value="${col.key.toLowerCase()}" />
                        <th><c:out value="${not empty _dunaColLabels[colKeyLower] ? _dunaColLabels[colKeyLower] : col.key}"/></th>
                    </c:forEach>
                </tr>
                </thead>
                <tbody>
                <c:forEach items="${resultRows}" var="row">
                    <tr>
                        <c:forEach items="${row}" var="cell">
                            <c:set var="ck" value="${cell.key.toLowerCase()}" />
                            <c:set var="cv" value="${cell.value}" />
                            <td>
                                <c:choose>
                                    <c:when test="${ck == 'status'}">
                                        <span class="badge ${cv == 'ACTIVE' || cv == 'WORKING' || cv == 'COMPLETED' || cv == 'PAID' || cv == 'SUCCESS' || cv == 'RUNNING' || cv == 'RESOLVED' ? 'badge-success' : (cv == 'LOCKED' || cv == 'CANCELLED' || cv == 'RESIGNED' || cv == 'FAILED' ? 'badge-danger' : 'badge-warning')}">
                                            <c:out value="${cv}"/>
                                        </span>
                                    </c:when>
                                    <c:when test="${ck == 'form_fit' || ck == 'formdang'}">
                                        <c:choose>
                                            <c:when test="${cv == 'SLIM_FIT'}">Dáng ôm</c:when>
                                            <c:when test="${cv == 'OVERSIZE'}">Form rộng</c:when>
                                            <c:when test="${cv == 'REGULAR_FIT'}">Dáng suông</c:when>
                                            <c:otherwise><c:out value="${cv}"/></c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:when test="${ck == 'parent_id'}">
                                        <c:choose>
                                            <c:when test="${empty cv}"><span style="color:var(--muted);">—</span></c:when>
                                            <c:otherwise><c:out value="${cv}"/></c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:when test="${ck == 'parent_name'}">
                                        <c:choose>
                                            <c:when test="${empty cv}"><span style="color:var(--muted);">Danh mục gốc</span></c:when>
                                            <c:otherwise><span class="badge badge-info"><c:out value="${cv}"/></span></c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:when test="${ck == 'is_active' || ck == 'is_featured' || ck == 'is_primary' || ck == 'is_default' || ck == 'is_online'}">
                                        <c:choose>
                                            <c:when test="${not empty cv && (cv.toString() == 'true' || cv.toString() == '1')}">Có</c:when>
                                            <c:otherwise>Không</c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:when test="${ck == 'barcode' || ck == 'sku' || ck == 'linked_code'}">
                                        <code style="font-weight:700;"><c:out value="${cv}"/></code>
                                    </c:when>
                                    <c:otherwise>
                                        <c:out value="${cv}"/>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                        </c:forEach>
                    </tr>
                </c:forEach>
                </tbody>
            </table>
        </c:otherwise>
    </c:choose>
</div>
