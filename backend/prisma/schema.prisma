datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 2.1. Phân quyền & Nhân sự
// ----------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(100)
  refundLimit BigInt?          @map("refund_limit")
  employees   Employee[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(100)
  module          String           @db.VarChar(50)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Employee {
  id                 BigInt                  @id @default(autoincrement())
  employeeCode       String                  @unique @map("employee_code") @db.VarChar(20)
  email              String                  @unique @db.VarChar(150)
  passwordHash       String                  @map("password_hash") @db.VarChar(255)
  fullName           String                  @map("full_name") @db.VarChar(120)
  phone              String                  @unique @db.VarChar(15)
  roleId             Int                     @map("role_id")
  status             String                  @default("ACTIVE") @db.VarChar(20)
  is2faEnabled       Boolean                 @default(false) @map("is_2fa_enabled")
  totpSecret         String?                 @map("totp_secret") @db.VarChar(255)
  failedLoginCount   Int                     @default(0) @map("failed_login_count")
  lockedUntil        DateTime?               @map("locked_until") @db.Timestamptz
  disabledReason     String?                 @db.Text @map("disabled_reason")
  mustChangePassword Boolean                 @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?               @map("password_changed_at") @db.Timestamptz
  lastLoginAt        DateTime?               @map("last_login_at") @db.Timestamptz
  lastTotpStep       BigInt?                 @map("last_totp_step")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role               Role                    @relation(fields: [roleId], references: [id])
  sessions           EmployeeSession[]
  recoveryCodes      EmployeeRecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]
  idempotencyKeys    IdempotencyKey[]

  @@map("employees")
}

model EmployeeSession {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       BigInt    @map("employee_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String    @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  familyId         String    @map("family_id") @db.Uuid
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  revokeReason     String?   @map("revoke_reason") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_sessions")
}

model EmployeeRecoveryCode {
  id         BigInt    @id @default(autoincrement())
  employeeId BigInt    @map("employee_id")
  codeHash   String    @map("code_hash") @db.VarChar(255)
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_recovery_codes")
}

model PasswordResetToken {
  id          BigInt    @id @default(autoincrement())
  employeeId  BigInt    @map("employee_id")
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ----------------------------------------------------
// 2.5 & 7.3. Idempotency & Audit
// ----------------------------------------------------

model IdempotencyKey {
  id             BigInt    @id @default(autoincrement())
  employeeId     BigInt    @map("employee_id")
  endpoint       String    @db.VarChar(200)
  key            String    @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  status         String    @default("IN_PROGRESS") @db.VarChar(20)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  actorEmpId  BigInt?   @map("actor_emp_id")
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.Text
  requestId   String?   @map("request_id") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee    Employee? @relation(fields: [actorEmpId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorEmpId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ----------------------------------------------------
// 8.1 & 11.8. Cấu hình hệ thống & Mã chứng từ & Kho
// ----------------------------------------------------

model SystemSetting {
  key         String    @id @db.VarChar(100)
  value       Json
  valueType   String    @map("value_type") @db.VarChar(20)
  description String?   @db.Text
  updatedBy   BigInt?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model DocumentSequence {
  prefix String @db.VarChar(10)
  period String @default("") @db.VarChar(6)
  lastNo Int    @default(0) @map("last_no")

  @@id([prefix, period])
  @@map("document_sequences")
}

model StockLocation {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("stock_locations")
}

model ShippingRateRule {
  id                   Int       @id @default(autoincrement())
  zoneCode             String    @map("zone_code") @db.VarChar(30)
  provinceCodes        String[]  @map("province_codes")
  baseWeightGram       Int       @default(500) @map("base_weight_gram")
  baseFee              BigInt    @map("base_fee")
  extraFeePer500g      BigInt    @map("extra_fee_per_500g")
  freeShipMinSubtotal  BigInt?   @map("free_ship_min_subtotal")
  isActive             Boolean   @default(true) @map("is_active")
  effectiveFrom        DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo          DateTime? @map("effective_to") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("shipping_rate_rules")
}

