<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:if test="${not empty moduleUcs}">
    <style>
        .duna-uc-workbench { margin-top: 22px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04); }
        .duna-uc-wb-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; margin-bottom: 14px; }
        .duna-uc-wb-title { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; }
        .duna-uc-wb-sub { font-size: 12.5px; color: #64748b; margin: 2px 0 0; }
        .duna-uc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(460px, 1fr)); gap: 10px; }
        .duna-uc-card { border: 1px solid #e2e8f0; border-radius: 10px; padding: 11px 13px; background: #f8fafc; transition: border-color .15s, background .15s; }
        .duna-uc-card.is-active { border-color: #0f172a; background: #eff6ff; }
        .duna-uc-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
        .duna-uc-code { display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; font-weight: 700; background: #0f172a; color: #fff; padding: 2px 7px; border-radius: 5px; }
        .duna-uc-mode { display: inline-block; font-size: 10.5px; font-weight: 700; padding: 2px 6px; border-radius: 5px; margin-left: 4px; }
        .duna-uc-mode.read { background: #e0f2fe; color: #0369a1; }
        .duna-uc-mode.write { background: #fef3c7; color: #b45309; }
        .duna-uc-name { font-size: 13px; font-weight: 600; color: #1e293b; line-height: 1.35; margin-top: 4px; }
        .duna-uc-form { display: flex; flex-wrap: wrap; gap: 6px; align-items: flex-end; }
        .duna-uc-field { display: flex; flex-direction: column; gap: 2px; min-width: 110px; flex: 1 1 120px; }
        .duna-uc-field label { font-size: 11px; color: #475569; font-weight: 600; }
        .duna-uc-field input { height: 30px; padding: 3px 8px; font-size: 12.5px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #0f172a; }
        @media (max-width: 640px) { .duna-uc-grid { grid-template-columns: 1fr; } }
    </style>

    <div class="duna-uc-workbench" id="dunaUcWorkbench">
        <div class="duna-uc-wb-head">
            <div>
                <h2 class="duna-uc-wb-title">Toàn bộ Use Case thuộc phân hệ này (${moduleUcs.size()} UC)</h2>
                <p class="duna-uc-wb-sub">Mỗi Use Case đều có nút tra cứu hoặc biểu mẫu tham số chạy trực tiếp vào SQL Server qua <code>/uc-run</code>.</p>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <input type="text" id="ucWbFilter" class="form-control" style="max-width:240px;height:34px;font-size:13px;"
                       placeholder="Lọc nhanh mã UC hoặc tên..." oninput="filterModuleUcs(this.value)">
                <a href="${pageContext.request.contextPath}/uc-hub" class="btn btn-outline btn-sm">Bản đồ 300 UC</a>
            </div>
        </div>

        <div class="duna-uc-grid">
            <c:forEach var="m" items="${moduleUcs}">
                <div class="duna-uc-card ${activeUc eq m.code ? 'is-active' : ''}" data-uc="${m.code} ${m.title}">
                    <div class="duna-uc-card-top">
                        <div>
                            <span class="duna-uc-code">${m.code}</span>
                            <span class="duna-uc-mode ${m.mode eq 'READ' ? 'read' : 'write'}">${m.mode eq 'READ' ? 'TRA CỨU' : 'CẬP NHẬT'}</span>
                            <div class="duna-uc-name"><c:out value="${m.title}"/></div>
                        </div>
                    </div>
                    <form method="${m.mode eq 'READ' ? 'get' : 'post'}" action="${pageContext.request.contextPath}/uc-run" class="duna-uc-form">
                        <input type="hidden" name="uc" value="${m.code}">
                        <c:forEach var="p" items="${m.params}">
                            <div class="duna-uc-field">
                                <label><c:out value="${p.label}"/></label>
                                <input type="${p.type}" name="${p.name}" value="<c:out value='${p.defaultValue}'/>" placeholder="<c:out value='${p.label}'/>">
                            </div>
                        </c:forEach>
                        <button type="submit" class="btn ${m.mode eq 'READ' ? 'btn-outline' : 'btn-primary'} btn-sm" style="height:30px;">
                            ${m.mode eq 'READ' ? 'Xem' : 'Chạy'} ${m.code}
                        </button>
                    </form>
                </div>
            </c:forEach>
        </div>
    </div>

    <script>
        function filterModuleUcs(q) {
            var kw = (q || '').trim().toLowerCase();
            var cards = document.querySelectorAll('#dunaUcWorkbench .duna-uc-card');
            for (var i = 0; i < cards.length; i++) {
                var hay = (cards[i].getAttribute('data-uc') || '').toLowerCase();
                cards[i].style.display = (!kw || hay.indexOf(kw) !== -1) ? '' : 'none';
            }
        }
    </script>
</c:if>
